include CHANGELOG.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include brightpath *.py
recursive-include brightpath/data/export *.csv *.json *.yaml *.md
recursive-include brightpath/data/migrations *.json *.md
recursive-include docs *.css *.py *.rst *.txt
prune docs/_build
exclude brightpath/data/export/list_ei3.9_cutoff_activities.csv
prune dev
prune .idea
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .ipynb_checkpoints
global-exclude .DS_Store
include docs/uvek_followup_decisions.json
include docs/uvek_priority_inventory_evidence.json
