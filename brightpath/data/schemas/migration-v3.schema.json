{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brightpath:migration:3",
  "title": "BrightPath migration resource v3",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "name",
    "status",
    "axis",
    "source_profiles",
    "target_profile",
    "reverse_policy",
    "replace",
    "disaggregate",
    "delete",
    "recipes",
    "reviews",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "brightpath.migration"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "active"
    },
    "axis": {
      "enum": [
        "technosphere",
        "biosphere"
      ]
    },
    "source_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "target_profile": {
      "$ref": "#/$defs/profile"
    },
    "reverse_policy": {
      "enum": [
        "explicit_only",
        "infer_with_policy"
      ]
    },
    "quality": {
      "enum": [
        "heuristic",
        "reviewed"
      ]
    },
    "replace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement"
      }
    },
    "disaggregate": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disaggregation"
      }
    },
    "delete": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deletion"
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/recipe"
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/review"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "source_profile": false,
    "rules": false,
    "targets": false
  },
  "additionalProperties": true,
  "$defs": {
    "reference_sign_decision": {
      "type": "object",
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["verified", "unresolved"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_sign": {"type": "integer", "enum": [-1, 1]},
        "target_sign": {"type": "integer", "enum": [-1, 1]},
        "role_conversion": {"const": "recovery_credit"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"required": ["source_sign", "target_sign"]}
      }, {
        "if": {"required": ["role_conversion"]},
        "then": {"properties": {"status": {"const": "verified"}, "source_sign": {"const": -1}, "target_sign": {"const": 1}}}
      }],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "reference product",
        "location",
        "unit"
      ],
      "properties": {
