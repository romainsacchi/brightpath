        "approved_omission_if_unavailable": {"const": true},
        "omission_rationale": {"type": "string", "minLength": 1},
        "biosphere_targets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["profile", "target", "reason"],
            "properties": {
              "profile": {"$ref": "#/$defs/profile"},
              "target": {"type": "object", "required": ["name", "categories", "unit"], "properties": {"name": {"type": "string", "minLength": 1}, "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "unit": {"type": "string", "minLength": 1}}, "additionalProperties": false},
              "reason": {"type": "string", "minLength": 1},
              "information_loss": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "amount": {
          "type": "number"
        },
        "uncertainty type": {
          "type": "integer",
          "minimum": 0
        },
        "loc": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "negative": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "recipe": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "recipe"
          ],
          "not": {
            "required": [
              "type"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "technosphere"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/identity"
            }
          ],
          "not": {
            "required": [
              "recipe"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "biosphere"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/biosphere"
            }
          ],
          "not": {
            "required": [
              "recipe"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "source_identities": {
          "type": "integer",
          "minimum": 0
        },
        "mapped_identities": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_identities": {
          "type": "integer",
          "minimum": 0
        },
        "target_identities": {
          "type": "integer",
          "minimum": 0
        },
        "mean_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mapping_methods": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dispositions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "approved_identities": false
      },
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "source_identities",
          "mapped_identities",
          "unresolved_identities"
        ]
      },
      "additionalProperties": true
