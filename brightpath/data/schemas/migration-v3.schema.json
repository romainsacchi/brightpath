{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brightpath:migration:3",
  "title": "BrightPath migration resource v3",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "name",
    "status",
    "axis",
    "source_profiles",
    "target_profile",
    "reverse_policy",
    "replace",
    "disaggregate",
    "delete",
    "recipes",
    "reviews",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "brightpath.migration"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "active"
    },
    "axis": {
      "enum": [
        "technosphere",
        "biosphere"
      ]
    },
    "source_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "target_profile": {
      "$ref": "#/$defs/profile"
    },
    "reverse_policy": {
      "enum": [
        "explicit_only",
        "infer_with_policy"
      ]
    },
    "quality": {
      "enum": [
        "heuristic",
        "reviewed"
      ]
    },
    "replace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replacement"
      }
    },
    "disaggregate": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disaggregation"
      }
    },
    "delete": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deletion"
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/recipe"
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/review"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "source_profile": false,
    "rules": false,
    "targets": false
  },
  "additionalProperties": true,
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "name",
        "reference product",
        "location",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reference product": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "biosphere": {
      "type": "object",
      "required": [
        "name",
        "categories",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "biosphere_target": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "uuid"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "recipe_ref": {
      "type": "object",
      "required": [
        "recipe_ref"
      ],
      "properties": {
        "recipe_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "family",
        "version"
      ],
      "properties": {
        "family": {
          "enum": [
            "ecoinvent",
            "uvek"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "system_model": {
          "enum": [
            "cutoff",
            "consequential"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch_method": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "comparison_source_revision": {
          "type": "string",
          "minLength": 1
        },
        "inventory_evidence": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "rationale"
      ]
    },
    "replacement": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "required": [
        "target"
      ],
      "properties": {
        "report_correspondence": {
          "type": "boolean"
        },
        "biosphere_information_loss": {
          "type": "string",
          "minLength": 1
        },
        "technosphere_information_loss": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/identity"
                },
                {
                  "$ref": "#/$defs/biosphere_target"
                }
              ],
              "not": {
                "required": [
                  "recipe_ref"
                ]
              }
            },
            {
              "$ref": "#/$defs/recipe_ref"
            }
          ]
        },
        "targets": false
      },
      "additionalProperties": true
    },
    "disaggregation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/identity"
              },
              {
                "$ref": "#/$defs/biosphere_target"
              }
            ],
            "properties": {
              "allocation": {
                "type": "number",
                "minimum": 0
              },
              "conversion_factor": {
                "type": "number",
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        "target": false
      },
      "additionalProperties": true
    },
    "deletion": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "properties": {
        "target": false,
        "targets": false,
        "conversion_factor": false
      },
      "additionalProperties": true
    },
    "recipe": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        }
      ],
      "type": "object",
      "required": [
        "inputs",
        "rationale",
        "evidence"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exchange"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "exchange": {
      "type": "object",
      "required": [
        "amount"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "uncertainty type": {
          "type": "integer",
          "minimum": 0
        },
        "loc": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "negative": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "recipe": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "recipe"
          ],
          "not": {
            "required": [
              "type"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "technosphere"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/identity"
            }
          ],
          "not": {
            "required": [
              "recipe"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "biosphere"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/biosphere"
            }
          ],
          "not": {
            "required": [
              "recipe"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "source_identities": {
          "type": "integer",
          "minimum": 0
        },
        "mapped_identities": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_identities": {
          "type": "integer",
          "minimum": 0
        },
        "target_identities": {
          "type": "integer",
          "minimum": 0
        },
        "mean_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mapping_methods": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dispositions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "approved_identities": false
      },
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "source_identities",
          "mapped_identities",
          "unresolved_identities"
        ]
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "$ref": "#/$defs/biosphere"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification": {
          "enum": [
            "correspondence",
            "proxy"
          ]
        },
        "mapping_method": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "factor": false,
        "recipe": false,
        "review_provenance": false,
        "conversion_factor": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "rationale": false,
        "evidence": false
      },
      "additionalProperties": true
    }
  }
}
