    "review": {
      "type": "object",
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch_method": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "comparison_source_revision": {
          "type": "string",
          "minLength": 1
        },
        "inventory_evidence": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "rationale"
      ]
    },
    "replacement": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "required": [
        "target"
      ],
      "properties": {
        "reference_flow_sign_review": {
          "type": "object",
          "required": ["status", "reason", "evidence"],
          "properties": {
            "status": {"enum": ["verified", "unresolved"]},
            "reason": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "source_sign": {"type": "integer", "enum": [-1, 1]},
            "target_sign": {"type": "integer", "enum": [-1, 1]},
            "role_conversion": {"const": "recovery_credit"},
            "profiles": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object",
                "required": ["source_profile", "review"],
                "properties": {
                  "source_profile": {"$ref": "#/$defs/profile"},
                  "review": {"$ref": "#/$defs/reference_sign_decision"},
                  "conversion_factor": {"type": "number", "not": {"const": 0}},
                  "target": {"$ref": "#/$defs/recipe_ref"},
                  "operation": {"const": "delete"},
                  "approved_omission": {"const": true},
                  "review_ref": {"type": "string", "minLength": 1}
                },
                "allOf": [{
                  "if": {"required": ["operation"]},
                  "then": {
                    "required": ["approved_omission", "review_ref"],
                    "properties": {"review": {"properties": {"status": {"const": "verified"}}, "not": {"required": ["role_conversion"]}}},
                    "allOf": [{"not": {"required": ["conversion_factor"]}}, {"not": {"required": ["target"]}}]
                  },
                  "else": {
                    "not": {"required": ["approved_omission"]},
                    "allOf": [{
                      "if": {"properties": {"review": {"required": ["role_conversion"]}}},
                      "then": {"required": ["review_ref"]},
                      "else": {"not": {"required": ["review_ref"]}}
                    }, {
                      "if": {"properties": {"review": {"properties": {"status": {"const": "verified"}}}}},
                      "then": {"required": ["conversion_factor"]},
                      "else": {"not": {"required": ["conversion_factor"]}}
                    }]
                  }
                }],
                "additionalProperties": false
              }
            }
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "verified"}}},
            "then": {"required": ["source_sign", "target_sign"]}
          }, {
            "if": {"required": ["profiles"]},
            "then": {"properties": {"status": {"const": "unresolved"}}}
          }, {
            "if": {"required": ["role_conversion"]},
            "then": {"properties": {"status": {"const": "verified"}, "source_sign": {"const": -1}, "target_sign": {"const": 1}}}
          }],
          "additionalProperties": false
        },
        "report_correspondence": {
          "type": "boolean"
        },
        "biosphere_information_loss": {
          "type": "string",
          "minLength": 1
        },
        "technosphere_information_loss": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/identity"
                },
                {
                  "$ref": "#/$defs/biosphere_target"
                }
              ],
              "not": {
                "required": [
                  "recipe_ref"
                ]
              }
            },
            {
              "$ref": "#/$defs/recipe_ref"
            }
          ]
        },
        "targets": false
      },
      "additionalProperties": true
    },
    "disaggregation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/identity"
              },
              {
                "$ref": "#/$defs/biosphere_target"
              }
            ],
            "properties": {
              "allocation": {
                "type": "number",
                "minimum": 0
              },
              "conversion_factor": {
                "type": "number",
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        "target": false
      },
      "additionalProperties": true
    },
    "deletion": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        }
      ],
      "properties": {
        "approved_omission": {"const": true},
        "target": false,
        "targets": false,
        "conversion_factor": false
      },
      "additionalProperties": true
    },
    "recipe": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "if": {"required": ["zero_burden"]},
          "then": {"required": ["zero_burden_reason"], "properties": {"inputs": {"maxItems": 0}}},
          "else": {"properties": {"inputs": {"minItems": 1}}, "not": {"required": ["zero_burden_reason"]}}
        }
      ],
      "type": "object",
      "required": [
        "inputs",
        "rationale",
        "evidence"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exchange"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "amount"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "amount": {"type": "number"},
              "formula": {"type": "string"},
              "uncertainty type": {"type": "integer", "minimum": 0},
              "loc": {"type": "number"},
              "scale": {"type": "number", "minimum": 0},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "negative": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "zero_burden": {"const": true},
        "zero_burden_reason": {"type": "string", "minLength": 1},
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "exchange": {
      "type": "object",
      "required": [
        "amount"
      ],
      "properties": {
        "zero_burden_supplier": {
          "type": "object",
          "required": [
            "rule_id",
            "source_profile",
            "profile_review_sha256"
          ],
          "properties": {
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "source_profile": {
              "$ref": "#/$defs/profile"
            },
