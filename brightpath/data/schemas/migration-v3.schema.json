            },
            {
              "$ref": "#/$defs/biosphere"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification": {
          "enum": [
            "correspondence",
            "proxy"
          ]
        },
        "mapping_method": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "factor": false,
        "recipe": false,
        "review_provenance": false,
        "conversion_factor": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "rationale": false,
        "evidence": false
      },
