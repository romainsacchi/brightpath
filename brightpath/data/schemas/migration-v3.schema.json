          "type": "string",
          "minLength": 1
        },
        "reference product": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "biosphere": {
      "type": "object",
